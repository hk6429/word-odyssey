{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "word-odyssey",
  "main": "edge.mjs",
  "compatibility_date": "2026-07-15",
  "workers_dev": true,
  "preview_urls": false,
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "none"
  },
  "vars": {
    "APP_ORIGIN": "https://word-odyssey.hk6429.workers.dev",
    "GOOGLE_CLIENT_ID": "980957938007-ci9cs6tb1khar0fdl6mlchu4u2165bqv.apps.googleusercontent.com"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROGRESS_STORE",
        "class_name": "ProgressStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ProgressStore"
      ]
    }
  ]
}
